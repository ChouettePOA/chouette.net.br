<script webc:type="js" webc:root="override">
	const body = (slots && slots.text && slots.text.default) || "";

	`<media class="s-invert reverse mi ProductHero" :@src="src" :@alt="alt">
		<div class="s-rich-text">
			<h1>${title || ""}</h1>
			${body}
			<btn class="ProductButton" href="${href}">Comprar agora</btn>
			<div class="ProductHero-chevron" aria-hidden="true"><span>⌄</span><span>⌄</span></div>
		</div>
	</media>`;
</script>

<style>
	.ProductHero {
		display: block;
	}
</style>
