<script webc:type="js">
	const title = this.title;
	const lede = this.lede;
	const intro = this.intro;
	const cover = this.cover;
	const coverAlt = this.coverAlt || this.coveralt || "";
	const buyHref = this.buyHref || this.buyhref;
	const ledeHtml = lede ? `<p class="ProductHero-lede">${lede}</p>` : "";
	const introHtml = intro ? `<p class="ProductHero-intro">${intro}</p>` : "";
	const coverHtml = cover ? `<img class="ProductHero-cover" src="${cover}" alt="${coverAlt}" loading="eager" decoding="async" />` : "";

	`<section class="ProductBand ProductBand--white ProductHero">
		<div class="ProductHero-grid">
			<div class="ProductHero-copy">
				<h1>${title}</h1>
				${ledeHtml}
				${introHtml}
				<a href="${buyHref}" class="ProductBuy">Comprar agora</a>
				<p class="ProductHero-chevron" aria-hidden="true"><span>⌄</span><span>⌄</span></p>
			</div>
			${coverHtml}
		</div>
	</section>`;
</script>
