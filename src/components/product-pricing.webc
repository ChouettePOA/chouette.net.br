<script webc:type="js">
	const price = this.price;
	const was = this.was;
	const buyHref = this.buyHref || this.buyhref;
	const wasHtml = was
		? `<p class="ProductPriceBlock-was">De R$ ${was}</p><p class="ProductPriceBlock-label">por apenas</p>`
		: `<p class="ProductPriceBlock-label">Por apenas</p>`;

	`<section class="ProductBand ProductBand--blue">
		<div class="ProductBand-inner ProductPriceBlock">
			<hr class="ProductPriceBlock-rule" />
			${wasHtml}
			<p class="ProductPriceBlock-now">R$ ${price},00</p>
			<a href="${buyHref}" class="ProductBuy">Comprar agora</a>
			<p class="ProductPriceBlock-note">Pagamento 100% seguro com acesso imediato</p>
		</div>
	</section>`;
</script>
