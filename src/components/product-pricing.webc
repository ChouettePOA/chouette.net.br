<div webc:root="override" class="u-container u-vspacer ProductPricing">
	<div class="u-container-inner">
		<div class="ProductPricing-img">
			<img
				:src="src"
				:alt="alt || title"
				eleventy:widths="400,600"
				:eleventy:ignore="ignore != null && ignore !== false ? '' : false"
			/>
		</div>
		<div class="ProductPricing-content">
			<slot></slot>
		</div>
		<hr/>
		<p class="ProductPricing-old-price">
			De&nbsp;<span @text="was"></span>
			<br/>
			Por apenas
		</p>
		<strong class="ProductPricing-price" @text="price"></strong>
		<btn class="ProductButton" :@href="href">Comprar agora</btn>
		<p class="small-print">Pagamento 100% seguro com acesso imediato</p>
	</div>
</div>

<style>
	.ProductPricing {
		display: block;
	}
</style>
