<script webc:type="js" webc:root="override">
	const body = (slots && slots.text && slots.text.default) || "";

	`<media
		class="ew mi center s-invert ProductSection"
		:@src="src"
		:@alt="alt"
		:@ignore="ignore"
	>
		<h2 class="ProductSection-title">${title}</h2>
		<div class="s-rich-text">
			${body}
		</div>
	</media>`;

</script>

